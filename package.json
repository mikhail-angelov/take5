{
  "name": "@mikhail.angelov/take5",
  "version": "1.0.0",
  "author": "Mikhail Angelov",
  "repository": {
    "url": "https://github.com/mikhail-angelov/take5"
  },
  "description": "Extension-first CLI for replaying captured web app flows",
  "type": "module",
  "bin": {
    "take5": "./src/cli.js"
  },
  "files": [
    "src/",
    "extension/",
    "fixtures/",
    "scripts/",
    "README.md"
  ],
  "scripts": {
    "start": "node src/cli.js run fixtures/sample-capture.json",
    "dev": "node src/cli.js run fixtures/sample-capture.json --cut-delays",
    "smoke": "node scripts/smoke-run.js",
    "test": "node --test"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "openai": "^4.47.1",
    "playwright": "^1.44.0"
  },
  "engines": {
    "node": ">=20.6.0"
  }
}
